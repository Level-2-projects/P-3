  Institution "1" --> "0..*" Patient : registers
  Patient "1" --> "0..*" BloodRequest : needs
  BloodRequest "0..1" --> "0..*" BloodRequest : follow-up of
  BloodRequest "1" *-- "0..*" RequestTarget : routed to
  RequestTarget "0..*" --> "1" BloodCenter : center
  BloodRequest "1" --> "0..*" Offer : receives
  BloodCenter "1" --> "0..*" Offer : makes
  Offer "1" *-- "0..*" ReservationItem : reserves
  BloodUnit "1" --> "0..*" ReservationItem : reserved in
  Offer "1" --> "0..*" PatientSample : tested with
  ReservationItem "1" --> "0..1" CrossmatchRecord : checked
  PatientSample "1" --> "0..*" CrossmatchRecord : used
  Offer "1" --> "0..1" Transfer : ships
  Transfer "1" *-- "0..*" TransferItem : contains
  BloodUnit "1" --> "0..*" TransferItem : moves
